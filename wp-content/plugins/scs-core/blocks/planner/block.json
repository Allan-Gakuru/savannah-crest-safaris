{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "scs/planner",
  "title": "Safari enquiry form",
  "category": "widgets",
  "icon": "location-alt",
  "description": "Show the configured enquiry form and verified trip context.",
  "textdomain": "scs-core",
  "usesContext": [
    "postId",
    "postType"
  ],
  "attributes": {
    "mode": {
      "type": "string",
      "enum": ["planner", "enquiry"],
      "default": "planner"
    }
  },
  "supports": {
    "html": false,
    "inserter": false
  },
  "editorScript": "scs-block-editor"
}
