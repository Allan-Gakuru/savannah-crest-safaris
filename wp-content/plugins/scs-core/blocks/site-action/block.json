{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "scs/site-action",
  "title": "Safari action",
  "category": "widgets",
  "icon": "location-alt",
  "description": "Link to the safari catalogue or the planner.",
  "textdomain": "scs-core",
  "usesContext": [
    "postId",
    "postType"
  ],
  "supports": {
    "html": false,
    "inserter": false
  },
  "attributes": {
    "action": {
      "type": "string",
      "default": "plan",
      "enum": [
        "plan",
        "explore"
      ]
    }
  },
  "editorScript": "scs-block-editor"
}
