{
  "$schema": "https://schemas.wp.org/wp/6.4/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "46rem",
      "wideSize": "76rem"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "palette": [
        {
          "slug": "espresso",
          "name": "Espresso",
          "color": "#2B1A14"
        },
        {
          "slug": "cream",
          "name": "Light cream",
          "color": "#F7F1E5"
        },
        {
          "slug": "gold",
          "name": "Antique gold",
          "color": "#B08A48"
        },
        {
          "slug": "sand",
          "name": "Pale sand",
          "color": "#EEE2D2"
        },
        {
          "slug": "paper",
          "name": "Paper",
          "color": "#FFFCF6"
        }
      ]
    },
    "spacing": {
