{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "scs/directory",
  "title": "Safari directory",
  "category": "widgets",
  "icon": "location-alt",
  "description": "List destinations or experiences ready for visitors.",
  "textdomain": "scs-core",
  "usesContext": [
    "postId",
    "postType"
  ],
  "supports": {
    "html": false,
    "inserter": false
  },
  "attributes": {
    "type": {
      "type": "string",
      "default": "destination",
      "enum": [
        "destination",
        "experience"
      ]
    }
  },
  "editorScript": "scs-block-editor"
}
